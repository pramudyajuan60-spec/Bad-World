strengths = Array[String](["Strongest individual units of the four factions", "Starts with 900 Parts and a DEA Armory that crafts weapons without Gun Shop money", "City Patrol generates passive income from idle patrolling units", "Can call a budgeted Allied DEA dispatch instead of facing hostile Heat/DEA waves"])
weaknesses = Array[String](["No B1 tier at all (more expensive roster floor, B2 minimum)", "No Factory/Dealer economy loop — no cartel cargo income", "Lowest max roster of the four factions (24 vs 30)"])
